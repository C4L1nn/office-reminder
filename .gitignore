# Runtime data - never committed; the app writes these under %LOCALAPPDATA%
# in a packaged build and under ./data when run from source.
/data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.lock

# Backups, exports and logs
/backups/
/exports/
/logs/
*.bak
*.backup

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials*
secrets*
auth.json

# Build output
/build/
/dist/
/build_test/
/dist_test/
*.zip

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
